# Use an Atlas Database Access user (not your Atlas website login).
# Percent-encode password characters such as @, :, /, ?, #, [ and ].
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=tasteloop
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password reset: enable debug only for local development. Debug responses
# include the reset token instead of sending email.
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_DEBUG=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# Stripe-hosted Checkout. Never expose these backend secrets to Vite/frontend code.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Webhooks require public HTTPS in production. For local testing, use Stripe CLI forwarding.
BACKEND_PUBLIC_URL=https://api.example.com

# Shared image storage for food images and complaint evidence.
# Leave AWS_S3_BUCKET empty to use backend/uploads locally.
# AWS_S3_PUBLIC_URL is optional for private buckets; signed URLs are returned when blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
